playwright-report/
test-results/
coverage/

# Local build artifacts and caches (fresh build performed inside container)
dist/
**/dist/
build/
**/build/
.eslintcache
*.tsbuildinfo
graphify-out/
.impeccable/

# IDE, editor, and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
